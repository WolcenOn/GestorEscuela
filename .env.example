# Database
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database

# Browser frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=https://wolcenon.github.io

# Legacy role bootstrap is disabled by default. Enable it only temporarily to migrate an older
# installation that still depends on the pre-Bearer actor-header bootstrap flow.
ALLOW_LEGACY_ROLE_BOOTSTRAP=false

# Password authentication session lifetime (hours). Default: 12.
AUTH_SESSION_TTL_HOURS=12

# Login throttling. Failed attempts are tracked by a SHA-256 fingerprint of the normalized email.
# Defaults: 5 failures inside 15 minutes trigger a 15 minute block.
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_BLOCK_MINUTES=15

# Default lifetime for school invitations (hours). Individual invitations can choose a shorter value.
INVITATION_TTL_HOURS=72

# Maximum accepted HTTP request body size in bytes (default: 4 MiB)
MAX_REQUEST_BODY_BYTES=4194304

# HSTS should stay enabled on HTTPS production deployments.
ENABLE_HSTS=true
